# =================================================================
# UMCP Frontend Client Environment Configuration Template
# =================================================================
# Copy this file to .env in the client/ directory:
#   cp client/.env.example client/.env
#
# NOTE: In local development, Vite proxies /api to http://localhost:5000.
# Configure these variables when deploying to standalone or custom domains.
# =================================================================

# Backend REST API Base URL (defaults to '/api/v1' using Vite reverse proxy)
VITE_API_BASE_URL=/api/v1

# Real-Time WebSocket Server URL (defaults to 'http://localhost:5000' in local dev)
VITE_SOCKET_URL=http://localhost:5000
