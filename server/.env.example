# =================================================================
# UMCP Backend Server Environment Configuration Template
# =================================================================
# Copy this file to .env in the server/ directory:
#   cp server/.env.example server/.env
#
# NOTE: Never commit your real .env file with production secrets.
# =================================================================

# Server Port (default: 5000)
PORT=5000

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# MongoDB Connection URI
# Local development with persistent MongoDB: mongodb://127.0.0.1:27017/umcp
# Production MongoDB Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/umcp?retryWrites=true&w=majority
# (If connection fails, server automatically falls back to in-memory mongodb-memory-server for local development)
MONGODB_URI=mongodb://127.0.0.1:27017/umcp

# JWT Authentication Secret (Use a strong, random 32+ character string in production)
JWT_SECRET=your_jwt_secret_key_here_min_32_characters

# JWT Expiration Period (e.g., '1d', '7d', '30d')
JWT_EXPIRES_IN=7d

# CORS Allowed Origin (Frontend URL)
CORS_ORIGIN=http://localhost:5173

# Optional Cloud Evidence Hosting (Cloudinary)
# If empty, uploaded photos are stored locally under server/uploads/
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional Google Gemini AI (For spatial cluster triangulation)
GEMINI_API_KEY=
